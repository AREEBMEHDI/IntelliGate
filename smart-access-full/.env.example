# ─── Database ────────────────────────────────────────────────────────────────
DB_USER=intelligate
DB_PASSWORD=change_this_strong_password
DB_NAME=intelligate
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://intelligate:change_this_strong_password@postgres:5432/intelligate

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── Storage (Cloudflare R2) — leave blank to skip file uploads in dev ────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET_NAME=intelligate-media
R2_PUBLIC_URL=https://your-bucket.r2.dev

# ─── Notifications — leave blank to skip in dev ───────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_FROM_NUMBER=+1234567890
ALERT_SMS_TO=+1234567890

SENDGRID_API_KEY=your_sendgrid_key
ALERT_EMAIL_FROM=alerts@yourdomain.com

# ─── Sentry — leave blank to disable error tracking in dev ───────────────────
SENTRY_DSN=

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=CHANGE_THIS_TOO

# Comma-separated allowed origins for CORS
# Add your frontend URL, ngrok URL, or deployed app URL here
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
