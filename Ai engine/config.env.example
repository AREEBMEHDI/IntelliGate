# ─── AI Engine Configuration ─────────────────────────────────────────────────
# Copy this file to config.env and fill in your values.
# NEVER commit config.env — it contains your facility API key.
#
# How to get these values:
#   1. Start the backend:  docker compose up -d
#   2. Create a superadmin user (see README)
#   3. POST /api/facilities/  →  copy the returned api_key and id
#   4. Create a gate:  POST /api/facilities/{id}/gates/  →  copy the gate id
# ─────────────────────────────────────────────────────────────────────────────

# Backend URL (use ngrok URL if the AI engine runs on a different machine)
CLOUD_API_URL=http://localhost:8000

# Facility API key returned by POST /api/facilities/
# Rotate at:  POST /api/facilities/{id}/rotate-key
FACILITY_API_KEY=your_facility_api_key_here

# Gate UUID — must exist in the gates table
GATE_ID=your_gate_uuid_here

# MJPEG stream port (optional, default: 5001)
STREAM_PORT=5001
